---
interface Props { steps: string[]; title: string; }
const { steps, title } = Astro.props;
---
<figure class="flow-figure">
  <figcaption><span class="mini-label">How it connects</span><span>Simplified project flow</span></figcaption>
  <ol class="flow" aria-label={`${title} project flow`}>
    {steps.map((step, i) => <li><span class="flow-number">0{i + 1}</span><strong>{step}</strong>{i < steps.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}</li>)}
  </ol>
</figure>
