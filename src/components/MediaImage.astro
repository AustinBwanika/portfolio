---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; eager?: boolean; }
const { src, alt, caption, eager = false } = Astro.props;
const widths = [480, 900, 1600].filter(w => w < src.width).concat(src.width);
---
<figure class="media-image">
  <a href={src.src} aria-label={`Open full-size image: ${alt}`}><Image src={src} alt={alt} widths={widths} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 85vw, 48vw" format="webp" loading={eager ? 'eager' : 'lazy'} decoding="async" /></a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
