---
import Layout from '../../layouts/Layout.astro';
import ProjectFlow from '../../components/ProjectFlow.astro';
import { projects, url } from '../../data/site';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const nextProject = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<Layout title={`${project.title} — Austin Bwanika`} description={project.summary}>
  <div class="case-shell">
    <header class="case-nav"><a class="monogram" href={url()} aria-label="Austin Bwanika home">ab<span>.</span></a><a class="text-link" href={url('#projects')}>← Back to selected work</a></header>
    <main id="main" tabindex="-1">
      <div class="case-hero"><p class="eyebrow">Project notes / {project.category}</p><h1>{project.title}<span class="terracotta">.</span></h1><p class="case-summary">{project.summary}</p><div class="case-meta"><span>{project.dates}</span><span class="status">{project.status}</span></div><ul class="tags" aria-label="Technologies">{project.technologies.map(t => <li>{t}</li>)}</ul><div class="project-links">{project.link && <a class="text-link" href={project.link.href}>{project.link.label} ↗</a>}{project.businessLink && <a class="text-link" href={project.businessLink.href}>{project.businessLink.label} ↗</a>}</div></div>
      <ProjectFlow steps={project.flow} title={project.title} />
      <div class="case-content"><section><p class="eyebrow">01 / Context</p><h2>The problem</h2><div class="section-body"><p>{project.problem}</p></div></section><section><p class="eyebrow">02 / Contribution</p><h2>My role</h2><div class="section-body"><p>{project.role}</p></div></section><section><p class="eyebrow">03 / Implementation</p><h2>How it works</h2><div class="section-body"><p>{project.solution}</p></div></section><section><p class="eyebrow">04 / Engineering choices</p><h2>Decisions & challenges</h2><div class="section-body">{project.decisions.map(d => <p>{d}</p>)}</div></section><section><p class="eyebrow">05 / Reflection</p><h2>Results & limitations</h2><div class="section-body"><p>{project.result}</p></div></section><section><p class="eyebrow">06 / Next steps</p><h2>What could come next</h2><div class="section-body"><p>{project.next}</p></div></section></div>
      <aside class="next-project"><span class="mini-label">Next project</span><a href={url(`projects/${nextProject.slug}/`)}>{nextProject.title} <span aria-hidden="true">→</span></a></aside>
    </main><footer><a href={url('#projects')}>← All selected work</a><span>Austin Bwanika</span></footer>
  </div>
</Layout>
